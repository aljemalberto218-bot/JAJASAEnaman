-- Key Verification Logic
local function checkKey()
    if KeyInput.Text == CORRECT_KEY then
        KeyVerified = true
        StatusLabel.TextColor3 = Color3.fromRGB(0, 210, 255)
        StatusLabel.Text = "Access Granted!"
        task.wait(0.5)
