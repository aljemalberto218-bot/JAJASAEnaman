-- Services
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Variables
local player = Players.LocalPlayer
local character = player.Character
local eggs = {}
local config = {
    password = "JA69",
    rarityPriority = {"Legendary", "Rare", "Uncommon", "Common"},
    eggsPriority = {},
    speed = 10,
    antiHit = true
}

-- GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Parent = player.PlayerGui
local frame = Instance.new("Frame")
frame.Parent = screenGui
frame.Size = UDim2.new(0.5, 0, 0.5, 0)
frame.Position = UDim2.new(0.25, 0, 0.25, 0)
local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1, 0, 0.1, 0)
title.Position = UDim2.new(0, 0, 0, 0)
title.Text = "JAJAmalakas"
local eggsList = Instance.new("ListLayout")
eggsList.Parent = frame
eggsList.HorizontalAlignment = Enum.HorizontalAlignment.Left
eggsList.VerticalAlignment = Enum.VerticalAlignment.Top

-- Functions
local function getEggs()
    for _, egg in pairs(ReplicatedStorage:GetChildren()) do
        if egg:IsA("Model") and egg.Name:lower():find("egg") then
            table.insert(eggs, egg)
        end
    end
end

local function sortEggs()
    table.sort(eggs, function(a, b)
        local aRarity = a:GetAttribute("Rarity")
        local bRarity = b:GetAttribute("Rarity")
        for i, rarity in pairs(config.rarityPriority) do
            if aRarity == rarity and bRarity ~= rarity then
                return true
            elseif aRarity ~= rarity and bRarity == rarity then
                return false
            end
        end
        return a.Name < b.Name
    end)
    for i, egg in pairs(eggs) do
        local eggLabel = Instance.new("TextLabel")
        eggLabel.Parent = frame
        eggLabel.Size = UDim2.new(1, 0, 0.05, 0)
        eggLabel.Position = UDim2.new(0, 0, 0.1 + (i - 1) * 0.05, 0)
        eggLabel.Text = egg.Name .. " - " .. egg:GetAttribute("Rarity")
    end
end

local function autoGetEggs()
    getEggs()
    sortEggs()
    for _, egg in pairs(eggs) do
        local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(character.HumanoidRootPart, tweenInfo, {CFrame = egg.HumanoidRootPart.CFrame})
        tween:Play()
        wait(0.1)
        character.HumanoidRootPart.CFrame = egg.HumanoidRootPart.CFrame
        egg:Destroy()
    end
end

local function antiHit()
    character.Humanoid.Touched:Connect(function(hit)
        if config.antiHit and hit.Parent ~= player then
            character.Humanoid:TakeDamage(0)
        end
    end)
end

local function speedTween()
    local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(character.Humanoid, tweenInfo, {WalkSpeed = config.speed})
    tween:Play()
end

local function keySystem()
    local input = UserInputService.InputBegan:Wait()
    if input.KeyCode == Enum.KeyCode.J then
        local passwordInput = Instance.new("TextBox")
        passwordInput.Parent = frame
        passwordInput.Size = UDim2.new(1, 0, 0.05, 0)
        passwordInput.Position = UDim2.new(0, 0, 0.6, 0)
        passwordInput.Focus()
        local submitButton = Instance.new("TextButton")
        submitButton.Parent = frame
        submitButton.Size = UDim2.new(1, 0, 0.05, 0)
        submitButton.Position = UDim2.new(0, 0, 0.65, 0)
        submitButton.Text = "Submit"
        submitButton.MouseButton1Click:Connect(function()
            if passwordInput.Text == config.password then
                autoGetEggs()
                speedTween()
                antiHit()
            end
        end)
    end
end

-- Events
keySystem()
